{
  "$schema": "https://json.schemastore.org/codex-hooks.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/block-destructive.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_build_android_apps_play_store__submit_for_review|mcp__plugin_build_android_apps_play_store__upload_aab",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/release-check.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/lint-kotlin.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/slop-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/stop-review.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
