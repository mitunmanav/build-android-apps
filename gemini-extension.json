{
  "name": "build-android-apps",
  "version": "2.0.0",
  "description": "Build and ship Android apps from your AI assistant: 29 skills (1 frontdoor + 28 specialists), 32 plain-English slash commands, 8 subagents, 5 MCP servers, 6 hooks \u2014 progressive disclosure keeps...",
  "author": {
    "name": "Mitun",
    "url": "https://github.com/mitunmanav"
  },
  "homepage": "https://github.com/mitunmanav/build-android-apps",
  "mcpServers": {
    "adb": {
      "command": "python3",
      "args": [
        "-m",
        "adb_mcp"
      ],
      "env": {
        "ANDROID_HOME": "${env:ANDROID_HOME}",
        "PATH": "${env:PATH}"
      }
    },
    "gradlew": {
      "command": "python3",
      "args": [
        "-m",
        "gradlew_mcp"
      ],
      "env": {
        "JAVA_HOME": "${env:JAVA_HOME}",
        "PATH": "${env:PATH}"
      }
    },
    "play-store": {
      "command": "python3",
      "args": [
        "-m",
        "play_store_mcp"
      ],
      "env": {
        "PATH": "${env:PATH}",
        "PLAY_STORE_CACHE": "${env:HOME}/.cache/build-android-apps/play-cache"
      }
    },
    "keystore": {
      "command": "python3",
      "args": [
        "-m",
        "keystore_mcp"
      ],
      "env": {
        "PATH": "${env:PATH}"
      }
    },
    "asset": {
      "command": "python3",
      "args": [
        "-m",
        "asset_mcp"
      ],
      "env": {
        "PATH": "${env:PATH}"
      }
    }
  },
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json"
}
